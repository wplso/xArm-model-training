    "OCSVM_G025": 0.25,
    "OCSVM_G1": 1.0,
    "OCSVM_G4": 4.0
  },
  "score_formulas": {
    "pca_q": "mean((Z - PCA.inverse_transform(PCA.transform(Z)))**2, axis=1)",
